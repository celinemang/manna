{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/feelings/layout,_N_T_/[locale]/feelings/page,_N_T_/en/feelings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/feelings/__PAGE__",
    "/$d$locale/feelings",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}