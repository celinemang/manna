{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/saved/layout,_N_T_/[locale]/saved/page,_N_T_/en/saved"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/saved/__PAGE__",
    "/$d$locale/saved",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}