{
  "name": "manna",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "web": "npm run dev --workspace=@manna/web",
    "build:web": "npm run build --workspace=@manna/web",
    "lint:web": "npm run lint --workspace=@manna/web"
  }
}
